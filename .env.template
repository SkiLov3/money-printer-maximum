# ProjectX API Credentials
PROJECTX_API_KEY=your_api_key_here
PROJECTX_ACCOUNT_ID=your_account_id_here
TOPSTEPX_USERNAME=your_username_here

# Risk Management Defaults
MAX_DAILY_LOSS=1000
MAX_DRAWDOWN=2000
MAX_POSITION_SIZE=1
STOP_LOSS_TICKS=40
TAKE_PROFIT_TICKS=80

# Strategy Settings — SYMBOL should be a single base ticker (e.g., NQ, MNQ, ES)
SYMBOL=NQ
INTERVAL=1m
# Set to "simulation" or "live" — DO NOT put inline comments on the same line!
MODE=simulation

# Bracket Orders (True/False) — Set to "false" if you have "Position Brackets"
# enabled in your TopstepX dashboard to avoid "Brackets cannot be used" errors.
USE_ORDER_BRACKETS=true

# Dashboard (optional — set a password before exposing remotely)
# DASHBOARD_PASSWORD=your_secure_password_here

# News Stand-Down Config (Minutes)
NEWS_STAND_DOWN_PRE=10
NEWS_STAND_DOWN_POST=20
