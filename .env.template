# ProjectX / TopstepX API Credentials
PROJECTX_API_KEY=your_api_key_here
PROJECTX_ACCOUNT_ID=your_account_id_here
TOPSTEPX_USERNAME=your_username_here

# Execution & Safety Interlock
# Real broker orders are dispatched ONLY when BOTH MODE=live AND ACTUAL_LIVE_TRADING=true.
# Any other combination intercepts orders safely in local simulation.
# Note: DO NOT add inline comments on the same line as variable values!
MODE=simulation
ACTUAL_LIVE_TRADING=false

# Risk Management Defaults (USD)
MAX_DAILY_LOSS=1000
MAX_DRAWDOWN=2000
MAX_POSITION_SIZE=1

# Strategy Fallback Defaults (Micro Futures: MES 4 ticks/pt, MCL 100 ticks/$1, MGC 10 ticks/$1)
SYMBOL=MES
INTERVAL=1m
STOP_LOSS_TICKS=40
TAKE_PROFIT_TICKS=80

# Bracket Orders (true/false) — Set to "false" if you have "Position Brackets"
# enabled in your TopstepX web dashboard to prevent duplicate bracket rejections.
USE_ORDER_BRACKETS=true

# Institutional Web Dashboard (http://127.0.0.1:8765)
# Set a strong password before exposing beyond localhost.
# DASHBOARD_PASSWORD=your_secure_password_here

# Economic News Stand-Down Buffer (Minutes)
NEWS_STAND_DOWN_PRE=10
NEWS_STAND_DOWN_POST=20
